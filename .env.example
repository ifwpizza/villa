# Copy to .env and fill in values. Never commit .env to git.

# Strong random strings (min 32 chars): openssl rand -base64 48
JWT_SECRET=
CSRF_SECRET=

# First run only: plain owner password (auto-hashed into OWNER_PASSWORD_HASH, then removed)
# OWNER_PASSWORD=

# After first run, use the bcrypt hash only:
OWNER_PASSWORD_HASH=

# Comma-separated browser origins allowed to call the API (include production URL)
CORS_ORIGIN=http://localhost:5173

# Server
PORT=3001
NODE_ENV=development

# Set true when serving over HTTPS (auto true when NODE_ENV=production)
# COOKIE_SECURE=true

# Vercel (Project → Settings → Environment Variables)
# JWT_SECRET=<openssl rand -base64 48>
# CSRF_SECRET=<openssl rand -base64 48>
# OWNER_PASSWORD_HASH=<copy from local .env after first run>
# CORS_ORIGIN=https://sagamontanavilla.vercel.app
# Optional: create a Blob store in Vercel → links BLOB_READ_WRITE_TOKEN for saved availability
